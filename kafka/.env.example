# Copia esto a .env en esta misma carpeta antes de correr `docker compose up`.

# Generar con:
#   docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=_LXX9IbxRHOKmj5irGTXVA

# Puerto del host donde el broker queda alcanzable desde fuera de Docker
# (por ejemplo desde un script local de producer/consumer o un plugin de IDE).
KAFKA_HOST_PORT=9094

# Puerto del host para la consola web de Kafka UI.
KAFKA_UI_PORT=8080

# Lista separada por comas de tópico:particiones:factor-de-replicación a
# crear al arrancar.
KAFKA_TOPICS=example-topic:3:1
