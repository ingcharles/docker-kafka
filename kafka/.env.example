# Copy to .env in this same folder before running `docker compose up`.

# Generate with:
#   docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=_LXX9IbxRHOKmj5irGTXVA

# Host port the broker is reachable on from outside Docker (e.g. from a
# local producer/consumer script or an IDE plugin).
KAFKA_HOST_PORT=9094

# Host port for the Kafka UI web console.
KAFKA_UI_PORT=8080

# Comma-separated list of topic:partitions:replication-factor to create
# on startup.
KAFKA_TOPICS=example-topic:3:1
