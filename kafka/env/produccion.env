# =============================================================================
# Kafka de PRODUCCIÓN: 3 nodos, replicación 3, min ISR 2. Sin secretos (el cluster id no lo es).
#   docker compose --env-file env/produccion.env -f docker-compose.ha.yml up -d --build
# =============================================================================
# Generar una vez por clúster: docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=CAMBIAR-generar-con-kafka-storage-random-uuid
KAFKA_CLUSTER_NOMBRE=produccion

# Activa el nodo 3.
COMPOSE_PROFILES=tres-nodos
KAFKA_QUORUM_VOTERS=1@broker-1:9093,2@broker-2:9093,3@broker-3:9093
KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9092,broker-3:9092
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_ISR=2

KAFKA_HOST_PORT_1=9094
KAFKA_HOST_PORT_2=9095
KAFKA_HOST_PORT_3=9096
KAFKA_UI_PORT=8080
KAFKA_NETWORK=kafka_net
# Memoria de cada JVM de Kafka.
KAFKA_HEAP_OPTS=-Xms1g -Xmx1g
