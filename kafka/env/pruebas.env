# =============================================================================
# Kafka de PRUEBAS: 2 nodos, replicación 2, min ISR 2. Sin secretos (el cluster id no lo es).
#   docker compose --env-file env/pruebas.env -f docker-compose.ha.yml up -d --build
# =============================================================================
# Generar una vez por clúster: docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=CAMBIAR-generar-con-kafka-storage-random-uuid
KAFKA_CLUSTER_NOMBRE=pruebas

# Votantes del quórum de controladores (los 2 nodos) y réplicas.
KAFKA_QUORUM_VOTERS=1@broker-1:9093,2@broker-2:9093
KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9092
KAFKA_REPLICATION_FACTOR=2
KAFKA_MIN_ISR=2

# Puertos del host (desde fuera de Docker) y de la consola web.
KAFKA_HOST_PORT_1=9094
KAFKA_HOST_PORT_2=9095
KAFKA_UI_PORT=8080
# Si ya tienes otro Kafka en la misma máquina, cambia el nombre de la red.
KAFKA_NETWORK=kafka_net
