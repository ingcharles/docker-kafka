# Configuración del gateway WSO2 para probar en tu máquina (WSO2 en Docker + servicios del clúster k3s expuestos con port-forward).
# Lo lee wso2/scripts/configurar-wso2.pl <ambiente>. Sin secretos: el usuario admin/admin es el de fábrica de la imagen de desarrollo.

# --- WSO2 ------------------------------------------------------------------------------------------------------------------------
WSO2_URL_ADMIN=https://localhost:9443
WSO2_URL_GATEWAY=https://localhost:8243
WSO2_ADMIN_USUARIO=admin
WSO2_ADMIN_CLAVE=admin

# --- A dónde reenvía el gateway ----------------------------------------------------------------------------------------------------
# Destino de cada API = BACKEND_BASE[:puerto del servicio]/<ruta base del servicio>. En un ambiente real BACKEND_BASE es el Ingress
# (https://facturacion-pruebas.<dominio>) y BACKEND_PUERTOS queda vacío: todos los servicios entran por 443 y el Ingress los reparte.
BACKEND_BASE=http://host.docker.internal
# Solo local: puerto de cada servicio en tu máquina (los abre wso2/scripts/exponer-servicios-k3s.sh). Evita 9091: lo usa Kafka.
BACKEND_PUERTOS=identidad-service=18091 comprobantes-service=18092 inventario-service=18093 firma-electronica-service=18094 sri-conector-service=18095 notificacion-service=18096 facturacion-orchestrator-service=18097

# --- Límites (peticiones por minuto) -----------------------------------------------------------------------------------------------
# Política de la aplicación cliente (todo lo que hace una api-key de WSO2, sumando todas las APIs).
LIMITE_APLICACION_POR_MIN=600
# Política de la suscripción (cada API a la que está suscrita la aplicación).
LIMITE_SUSCRIPCION_POR_MIN=600
# Operaciones sensibles a fuerza bruta: login, alta de usuarios, cambio de clave, creación de api-keys (ver wso2/politicas.conf).
LIMITE_SENSIBLE_POR_MIN=10
# Emisión de comprobantes (POST de comprobantes-service).
LIMITE_EMISION_POR_MIN=120

# --- Cliente de ejemplo ------------------------------------------------------------------------------------------------------------
APLICACION_NOMBRE=cliente-facturacion-local
# Vigencia de la api-key de WSO2 que se entrega a ese cliente, en segundos (2592000 = 30 días).
API_KEY_VIGENCIA_SEG=2592000
