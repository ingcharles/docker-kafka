# Gateway WSO2 de PRODUCCIÓN (el de la plataforma). Reemplaza los marcadores CAMBIAR-... antes de ejecutar configurar-wso2.pl produccion.
# Sin secretos: la clave del administrador de WSO2 NO va aquí; se pasa por la variable de entorno WSO2_ADMIN_CLAVE al ejecutar.

WSO2_URL_ADMIN=https://CAMBIAR-wso2-produccion:9443
WSO2_URL_GATEWAY=https://CAMBIAR-gateway-produccion
WSO2_ADMIN_USUARIO=CAMBIAR-usuario-administrador

# Ingress del clúster de producción (overlays/produccion/ingress.yaml en facturacion-despliegue). Sin puertos por servicio.
BACKEND_BASE=https://facturacion.dominio-por-definir.example
BACKEND_PUERTOS=

# Ajusta con tráfico real: estos son el punto de partida. SENSIBLE y EMISION son por aplicación; *_TOTAL_* suma a todos los clientes.
LIMITE_APLICACION_POR_MIN=1200
LIMITE_SUSCRIPCION_POR_MIN=1200
LIMITE_SENSIBLE_POR_MIN=5
LIMITE_SENSIBLE_TOTAL_POR_MIN=100
LIMITE_EMISION_POR_MIN=300
LIMITE_EMISION_TOTAL_POR_MIN=3000

APLICACION_NOMBRE=cliente-facturacion
# Una vigencia corta obliga a rotar la api-key de WSO2 (31536000 = 1 año).
API_KEY_VIGENCIA_SEG=31536000
