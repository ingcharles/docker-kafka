# Gateway WSO2 de PRUEBAS (el de la plataforma). Reemplaza los marcadores CAMBIAR-... antes de ejecutar configurar-wso2.pl pruebas.
# Sin secretos: la clave del administrador de WSO2 NO va aquí; se pasa por la variable de entorno WSO2_ADMIN_CLAVE al ejecutar.

WSO2_URL_ADMIN=https://CAMBIAR-wso2-pruebas:9443
WSO2_URL_GATEWAY=https://CAMBIAR-gateway-pruebas:8243
WSO2_ADMIN_USUARIO=CAMBIAR-usuario-administrador

# Ingress del clúster de pruebas (overlays/pruebas/ingress.yaml en facturacion-despliegue). Sin puertos por servicio.
BACKEND_BASE=https://facturacion-pruebas.dominio-por-definir.example
BACKEND_PUERTOS=

LIMITE_APLICACION_POR_MIN=600
LIMITE_SUSCRIPCION_POR_MIN=600
LIMITE_SENSIBLE_POR_MIN=10
LIMITE_EMISION_POR_MIN=120

APLICACION_NOMBRE=cliente-facturacion-pruebas
API_KEY_VIGENCIA_SEG=2592000
