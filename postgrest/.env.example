# Copy to .env in this same folder before running `docker compose up`.
# Never commit the real .env — it holds credentials.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-super-secret
POSTGRES_DB=app

# Password for the low-privilege role PostgREST authenticates as.
# Generate with: openssl rand -base64 24
AUTHENTICATOR_PASSWORD=change-me-authenticator-secret

# Must be 32+ characters. Generate with: openssl rand -base64 33
PGRST_JWT_SECRET=change-me-jwt-secret-32-chars-minimum

# Host ports.
POSTGRES_PORT=5432
POSTGREST_PORT=3000
