# Copia esto a .env en esta misma carpeta antes de correr `docker compose up`.
# Nunca subas el .env real — contiene credenciales.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=facturacion
POSTGRES_PORT=5434

# Una contraseña por cada rol de esquema. Generar con: openssl rand -base64 24
INVENTARIO_DB_PASSWORD=change-me-inventario-service-secret
FIRMA_DB_PASSWORD=change-me-firma-service-secret
COMPROBANTES_DB_PASSWORD=change-me-comprobantes-service-secret
SRI_DB_PASSWORD=change-me-sri-service-secret
NOTIFICACION_DB_PASSWORD=change-me-notificacion-service-secret
ORQUESTACION_DB_PASSWORD=change-me-orquestacion-service-secret
IDENTIDAD_DB_PASSWORD=change-me-identidad-service-secret
