# Copia esto a .env en esta misma carpeta antes de correr `docker compose up`.
# Nunca subas el .env real — contiene credenciales.
# El stack de kafka/ debe estar corriendo de antemano (su broker se
# reutiliza acá) — o lo levantas primero, o usas el docker-compose.yml de
# la raíz que levanta a ambos.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=facturacion
POSTGRES_PORT=5434

# Una contraseña por cada rol de esquema. Generar con: openssl rand -base64 24
INVENTARIO_DB_PASSWORD=change-me-inventario-service-secret
FIRMA_DB_PASSWORD=change-me-firma-service-secret
COMPROBANTES_DB_PASSWORD=change-me-comprobantes-service-secret
SRI_DB_PASSWORD=change-me-sri-service-secret
NOTIFICACION_DB_PASSWORD=change-me-notificacion-service-secret
ORQUESTACION_DB_PASSWORD=change-me-orquestacion-service-secret
IDENTIDAD_DB_PASSWORD=change-me-identidad-service-secret

# Clave maestra (AES-256) con la que firma-electronica-service cifra en
# reposo el contenido del .p12 y su contraseña antes de guardarlos en la
# base de datos. Generar con: openssl rand -base64 32
FIRMA_CIFRADO_CLAVE_MAESTRA=change-me-32-bytes-master-key

# Llaves con las que identidad-service firma los JWT (Ed25519). La PRIVADA solo la usa identidad-service; los demás
# servicios reciben únicamente la PÚBLICA, así que un servicio comprometido no puede fabricar tokens.
# Generar el par (una línea cada una) con: ./scripts/generar-claves-jwt.sh
IDENTIDAD_JWT_CLAVE_PRIVADA=
IDENTIDAD_JWT_CLAVE_PUBLICA=

# Orígenes del navegador autorizados por CORS en todos los servicios (separados por coma, sin comodín *).
# En producción pon aquí solo el dominio real del frontend, p. ej. https://facturacion.miempresa.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Puertos del host para la API REST de cada servicio.
FIRMA_SERVICE_PORT=8091
INVENTARIO_SERVICE_PORT=8092
COMPROBANTES_SERVICE_PORT=8093
SRI_SERVICE_PORT=8094
NOTIFICACION_SERVICE_PORT=8095
ORQUESTACION_SERVICE_PORT=8096
IDENTIDAD_SERVICE_PORT=8097

# SMTP real usado por notificacion-service para enviar el comprobante
# autorizado (RIDE + XML) al receptor. Con Gmail, el puerto 587 usa
# STARTTLS; si tu proveedor usa SSL directo, cambia a 465 y ajusta
# SMTP_STARTTLS=false / SMTP_SSL=true en application.properties.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=change-me@gmail.com
SMTP_PASSWORD=change-me-app-password
SMTP_FROM=change-me@gmail.com

# Token para MODIFICAR los catálogos del SRI (PUT /catalogos en comprobantes-service). Son datos globales: una
# api-key de empresa no puede cambiarlos. Sin token, la escritura queda deshabilitada (403).
# Generar con: openssl rand -base64 32
CATALOGOS_ADMIN_TOKEN=

# Descuento de inventario en la saga (orquestador). true: una factura con items de inventario reserva el stock antes de
# firmar, lo confirma al autorizar el SRI y lo libera si rechaza. false: el inventario no interviene (comportamiento anterior).
INVENTARIO_DESCUENTO_HABILITADO=true

# Host de Postgres que ven los servicios dentro de Docker (por defecto el contenedor facturacion-db de D:/inf_sri/CONTENEDORES/postgres).
# DB_HOST=facturacion-db
