# =============================================================================
# Ambiente: PRUEBAS (QA / integración; usa la base facturacion-test-db)
# -----------------------------------------------------------------------------
# SIN SECRETOS: este archivo se sube a git. Contraseñas, claves y tokens van en
# env/pruebas.secretos.env (ignorado por git; plantilla: env/secretos.env.example).
# Se levanta con:  ./scripts/compose.sh pruebas up -d
# Emite comprobantes con el ambiente PRUEBAS del SRI: no tienen validez tributaria.
# =============================================================================

# --- Postgres de pruebas (contenedor facturacion-test-db) ---------------------
# Compose solo lee POSTGRES_DB y DB_HOST (los servicios usan el puerto 5432 dentro de la red de Docker); POSTGRES_USER y
# POSTGRES_PORT documentan el acceso desde el host (psql, DBeaver).
POSTGRES_USER=postgres
POSTGRES_DB=facturacion
POSTGRES_PORT=5435
DB_HOST=facturacion-test-db

# --- Web ----------------------------------------------------------------------
# Si pruebas con un frontend desplegado, agrega aquí su dominio (separados por coma, sin comodín *).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Puertos del host (API REST de cada servicio) -----------------------------
FIRMA_SERVICE_PORT=8091
INVENTARIO_SERVICE_PORT=8092
COMPROBANTES_SERVICE_PORT=8093
SRI_SERVICE_PORT=8094
NOTIFICACION_SERVICE_PORT=8095
ORQUESTACION_SERVICE_PORT=8096
IDENTIDAD_SERVICE_PORT=8097

# --- Correo saliente (usuario y contraseña van en el archivo de secretos) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Saga ---------------------------------------------------------------------
INVENTARIO_DESCUENTO_HABILITADO=true

# Reenvío automático de correos fallidos: ENCENDIDO en pruebas, con tiempos cortos para verlo funcionar
# (cada 2 min, 20 sagas por ciclo, 5 min entre reenvíos de la misma saga, máximo 3 reenvíos por saga).
SAGA_REENVIO_NOTIFICACIONES_HABILITADO=true
SAGA_REENVIO_NOTIFICACIONES_INTERVALO=2m
SAGA_REENVIO_NOTIFICACIONES_LOTE=20
SAGA_REENVIO_NOTIFICACIONES_ESPERA_MINIMA=PT5M
SAGA_REENVIO_NOTIFICACIONES_PLAZO_RESPUESTA=PT5M
SAGA_REENVIO_NOTIFICACIONES_MAX_INTENTOS=3

# --- Kafka --------------------------------------------------------------------
# Clúster de 2 nodos (../kafka/env/pruebas.env): 2 copias de cada tópico y las 2 sincronizadas para aceptar un mensaje
# (acks=all): la misma durabilidad que producción. Con un nodo caído las escrituras se detienen (no hay mayoría de
# controladores); sirve para probar el comportamiento ante una caída, no para tolerarla.
KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9092
KAFKA_REPLICATION_FACTOR=2
KAFKA_MIN_ISR=2
# Retención de las colas de mensajes fallidos (.dlq): 30 días. Los eventos usan la del broker (7 días).
KAFKA_DLQ_RETENCION_MS=2592000000

# --- Observabilidad (opcional) ------------------------------------------------
# OBSERVABILIDAD_HABILITADA=true levanta Prometheus, Alertmanager, Grafana, Loki, Alloy y los exportadores de Postgres y
# Kafka (los activa scripts/compose.sh). Apagada, los servicios funcionan igual. Guía: observabilidad/README.md.
OBSERVABILIDAD_HABILITADA=true
# Solo servidor Linux: CPU, memoria, disco y reloj del servidor (node-exporter y cAdvisor).
OBSERVABILIDAD_HOST_HABILITADA=false
# Logs en JSON (una línea por log) para Loki; apagado, texto legible.
LOG_FORMATO_JSON=true
# Un broker de Kafka al que se conecta el exportador (descubre los demás).
KAFKA_EXPORTER_BROKER=broker-1:9092
