# =============================================================================
# PLANTILLA de secretos. Cópiala una vez por ambiente y completa los valores:
#   cp env/secretos.env.example env/desarrollo.secretos.env     (o pruebas / produccion)
# Esos archivos *.secretos.env los ignora git: NUNCA subas uno con valores reales.
# Usa valores DISTINTOS en cada ambiente.
# =============================================================================

# Superusuario de Postgres. Lo usa el stack de Postgres y tus herramientas (psql, DBeaver), no estos servicios.
POSTGRES_PASSWORD=

# Una contraseña por cada rol de esquema. Generar cada una con: openssl rand -base64 24
INVENTARIO_DB_PASSWORD=
FIRMA_DB_PASSWORD=
COMPROBANTES_DB_PASSWORD=
SRI_DB_PASSWORD=
NOTIFICACION_DB_PASSWORD=
ORQUESTACION_DB_PASSWORD=
IDENTIDAD_DB_PASSWORD=

# Clave maestra (AES-256) con la que firma-electronica-service cifra el .p12 y su contraseña en la base.
# Si la pierdes, los certificados guardados no se pueden descifrar. Generar con: openssl rand -base64 32
FIRMA_CIFRADO_CLAVE_MAESTRA=

# Par Ed25519 con el que identidad-service firma los JWT (una línea cada una). La PRIVADA solo la usa identidad-service.
# Las agrega el script, que imprime las dos líneas:  ./scripts/generar-claves-jwt.sh >> env/<ambiente>.secretos.env
# IDENTIDAD_JWT_CLAVE_PRIVADA=
# IDENTIDAD_JWT_CLAVE_PUBLICA=

# Token para modificar los catálogos del SRI (PUT /catalogos). Vacío = escritura deshabilitada (403).
# Generar con: openssl rand -base64 32
CATALOGOS_ADMIN_TOKEN=

# Cuenta SMTP de notificacion-service. Con Gmail: verificación en dos pasos + "contraseña de aplicación"
# (la contraseña normal no funciona).
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Observabilidad (solo si OBSERVABILIDAD_HABILITADA=true) ---
# Clave del administrador de Grafana.
GRAFANA_ADMIN_PASSWORD=
# Clave del rol de solo lectura "observabilidad" de Postgres (se crea con observabilidad/crear-rol-monitoreo.sql).
OBSERVABILIDAD_DB_PASSWORD=
