# =============================================================================
# Ambiente: PRODUCCIÓN
# -----------------------------------------------------------------------------
# SIN SECRETOS: este archivo se sube a git. Contraseñas, claves y tokens van en
# env/produccion.secretos.env (ignorado por git; plantilla: env/secretos.env.example),
# o en el gestor de secretos del servidor. NUNCA los pegues en este archivo.
# Se levanta con:  ./scripts/compose.sh produccion up -d
# Los valores CAMBIAR-... son a propósito inválidos: no arranques sin reemplazarlos.
# =============================================================================

# --- Postgres de producción ---------------------------------------------------
# Compose solo lee POSTGRES_DB y DB_HOST (los servicios usan el puerto 5432 dentro de la red de Docker); POSTGRES_USER y
# POSTGRES_PORT documentan el acceso desde el host (psql, DBeaver).
POSTGRES_USER=postgres
POSTGRES_DB=facturacion
POSTGRES_PORT=5432
DB_HOST=CAMBIAR-host-postgres-produccion

# --- Web ----------------------------------------------------------------------
# SOLO el dominio real del frontend (https, sin comodín *). Ejemplo: https://facturacion.miempresa.com
CORS_ORIGINS=https://CAMBIAR-dominio-del-frontend

# --- Puertos del host (API REST de cada servicio) -----------------------------
# En producción publícalos detrás de un proxy inverso con TLS; no los expongas a internet directamente.
FIRMA_SERVICE_PORT=8091
INVENTARIO_SERVICE_PORT=8092
COMPROBANTES_SERVICE_PORT=8093
SRI_SERVICE_PORT=8094
NOTIFICACION_SERVICE_PORT=8095
ORQUESTACION_SERVICE_PORT=8096
IDENTIDAD_SERVICE_PORT=8097

# --- Correo saliente (usuario y contraseña van en el archivo de secretos) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Saga ---------------------------------------------------------------------
INVENTARIO_DESCUENTO_HABILITADO=true

# Reenvío automático de correos fallidos: APAGADO hasta que decidas activarlo en producción (envía correos solo).
# El reenvío manual (POST /sagas/reenviar-notificaciones) funciona igual. Para activarlo: HABILITADO=true.
SAGA_REENVIO_NOTIFICACIONES_HABILITADO=false
SAGA_REENVIO_NOTIFICACIONES_INTERVALO=5m
SAGA_REENVIO_NOTIFICACIONES_LOTE=20
SAGA_REENVIO_NOTIFICACIONES_ESPERA_MINIMA=PT15M
SAGA_REENVIO_NOTIFICACIONES_PLAZO_RESPUESTA=PT10M
SAGA_REENVIO_NOTIFICACIONES_MAX_INTENTOS=3

# --- Kafka --------------------------------------------------------------------
# Clúster de 4 nodos, 3 de ellos controladores (../kafka/env/produccion.env): 3 copias de cada tópico y al menos 2
# sincronizadas para aceptar un mensaje (los productores usan acks=all). Con menos de 3 brokers, los tópicos no se crean
# (replicación 3 > brokers).
KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9092,broker-3:9092,broker-4:9092
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_ISR=2
# Retención de las colas de mensajes fallidos (.dlq): 30 días. Los eventos usan la del broker (7 días).
KAFKA_DLQ_RETENCION_MS=2592000000

# --- Observabilidad (opcional) ------------------------------------------------
# OBSERVABILIDAD_HABILITADA=true levanta Prometheus, Alertmanager, Grafana, Loki, Alloy y los exportadores de Postgres y
# Kafka (los activa scripts/compose.sh). Apagada, los servicios funcionan igual. Guía: observabilidad/README.md.
OBSERVABILIDAD_HABILITADA=true
# Solo servidor Linux: CPU, memoria, disco y reloj del servidor (node-exporter y cAdvisor).
OBSERVABILIDAD_HOST_HABILITADA=true
# Logs en JSON (una línea por log) para Loki; apagado, texto legible.
LOG_FORMATO_JSON=true
# Un broker de Kafka al que se conecta el exportador (descubre los demás).
KAFKA_EXPORTER_BROKER=broker-1:9092

# --- Postgres: pooler, réplica y respaldo (guía en ../../postgres/README.md) --------------------------------------------
# En producción Postgres es el tuyo (DB_HOST); estas banderas solo aplican si usas el stack de ../postgres en un servidor.
# Con tu propio Postgres instala pgBackRest y PgBouncer allí con esta misma configuración (postgres/README.md).
PGBOUNCER_HABILITADO=false
PGBOUNCER_POOL_POR_ROL=10
PGBOUNCER_MAX_CONEXIONES_BD=100
REPLICACION_HABILITADA=false
# Respaldo continuo (pgBackRest) hacia S3 de un proveedor, con clave de cifrado. RESPALDO_S3_ENDPOINT, el bucket y las
# claves de acceso son de ese proveedor; el almacén S3 propio es solo para desarrollo/pruebas.
RESPALDO_HABILITADO=false
RESPALDO_REPO=s3
RESPALDO_ALMACEN_LOCAL_HABILITADO=false
RESPALDO_S3_ENDPOINT=CAMBIAR-s3.proveedor.example
RESPALDO_S3_BUCKET=CAMBIAR-bucket-respaldos
RESPALDO_S3_REGION=us-east-1
RESPALDO_S3_VERIFICAR_TLS=y
RESPALDO_RETENCION_COMPLETOS=4
RESPALDO_RETENCION_DIFERENCIALES=7

# --- Alertas por correo (opcional; requiere OBSERVABILIDAD_HABILITADA=true) ---------------------------------------------
# Alertmanager envía cada alerta (críticas: cada hora hasta resolverse) a estos correos. La clave del SMTP va en el archivo de
# secretos (ALERTAS_SMTP_PASSWORD). Con Gmail: smtp.gmail.com:587 y una "contraseña de aplicación".
ALERTAS_CORREO_HABILITADO=false
ALERTAS_CORREO_DESTINATARIOS=
ALERTAS_CORREO_REMITENTE=
ALERTAS_SMTP_HOST=smtp.gmail.com:587
ALERTAS_SMTP_USUARIO=
ALERTAS_SMTP_REQUIERE_TLS=true
