# =============================================================================
# Ambiente: DESARROLLO (tu máquina local)
# -----------------------------------------------------------------------------
# SIN SECRETOS: este archivo se sube a git. Contraseñas, claves y tokens van en
# env/desarrollo.secretos.env (ignorado por git; plantilla: env/secretos.env.example).
# Se levanta con:  ./scripts/compose.sh desarrollo up -d
# =============================================================================

# --- Postgres (stack de D:/inf_sri/CONTENEDORES/postgres) ---------------------
# Compose solo lee POSTGRES_DB y DB_HOST (los servicios usan el puerto 5432 dentro de la red de Docker); POSTGRES_USER y
# POSTGRES_PORT documentan el acceso desde el host (psql, DBeaver).
POSTGRES_USER=postgres
POSTGRES_DB=facturacion
POSTGRES_PORT=5434
DB_HOST=facturacion-db

# --- Web ----------------------------------------------------------------------
# Orígenes del navegador permitidos por CORS (separados por coma, sin comodín *).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Puertos del host (API REST de cada servicio) -----------------------------
FIRMA_SERVICE_PORT=8091
INVENTARIO_SERVICE_PORT=8092
COMPROBANTES_SERVICE_PORT=8093
SRI_SERVICE_PORT=8094
NOTIFICACION_SERVICE_PORT=8095
ORQUESTACION_SERVICE_PORT=8096
IDENTIDAD_SERVICE_PORT=8097

# --- Correo saliente (usuario y contraseña van en el archivo de secretos) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Saga ---------------------------------------------------------------------
# Reserva el stock antes de firmar, lo confirma al autorizar y lo libera si el SRI rechaza.
INVENTARIO_DESCUENTO_HABILITADO=true

# Reenvío automático de correos fallidos (job del orquestador). Apagado en desarrollo: el reenvío manual
# (POST /sagas/reenviar-notificaciones) funciona igual. Para probar el job, enciéndelo y baja los tiempos.
SAGA_REENVIO_NOTIFICACIONES_HABILITADO=false
SAGA_REENVIO_NOTIFICACIONES_INTERVALO=5m
SAGA_REENVIO_NOTIFICACIONES_LOTE=20
SAGA_REENVIO_NOTIFICACIONES_ESPERA_MINIMA=PT15M
SAGA_REENVIO_NOTIFICACIONES_PLAZO_RESPUESTA=PT10M
SAGA_REENVIO_NOTIFICACIONES_MAX_INTENTOS=3

# --- Kafka --------------------------------------------------------------------
# Un solo broker (desarrollo/pruebas): sin réplicas. Para probar con alta disponibilidad usa ../kafka/docker-compose.ha.yml
# con KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9092,broker-3:9092, KAFKA_REPLICATION_FACTOR=3 y KAFKA_MIN_ISR=2.
KAFKA_BOOTSTRAP_SERVERS=broker:9092
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_ISR=1
# Retención de las colas de mensajes fallidos (.dlq): 30 días. Los eventos usan la del broker (7 días).
KAFKA_DLQ_RETENCION_MS=2592000000
