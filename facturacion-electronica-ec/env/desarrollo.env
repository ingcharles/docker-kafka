# =============================================================================
# Ambiente: DESARROLLO (tu máquina local)
# -----------------------------------------------------------------------------
# SIN SECRETOS: este archivo se sube a git. Contraseñas, claves y tokens van en
# env/desarrollo.secretos.env (ignorado por git; plantilla: env/secretos.env.example).
# Se levanta con:  ./scripts/compose.sh desarrollo up -d
# =============================================================================

# --- Postgres (stack de D:/inf_sri/CONTENEDORES/postgres) ---------------------
# Compose solo lee POSTGRES_DB y DB_HOST (los servicios usan el puerto 5432 dentro de la red de Docker); POSTGRES_USER y
# POSTGRES_PORT documentan el acceso desde el host (psql, DBeaver).
POSTGRES_USER=postgres
POSTGRES_DB=facturacion
POSTGRES_PORT=5436
DB_HOST=facturacion-db

# --- Web ----------------------------------------------------------------------
# Orígenes del navegador permitidos por CORS (separados por coma, sin comodín *).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Puertos del host (API REST de cada servicio) -----------------------------
FIRMA_SERVICE_PORT=8091
INVENTARIO_SERVICE_PORT=8092
COMPROBANTES_SERVICE_PORT=8093
SRI_SERVICE_PORT=8094
NOTIFICACION_SERVICE_PORT=8095
ORQUESTACION_SERVICE_PORT=8096
IDENTIDAD_SERVICE_PORT=8097

# --- Correo saliente (usuario y contraseña van en el archivo de secretos) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Saga ---------------------------------------------------------------------
# Reserva el stock antes de firmar, lo confirma al autorizar y lo libera si el SRI rechaza.
INVENTARIO_DESCUENTO_HABILITADO=true

# Reenvío automático de correos fallidos (job del orquestador). Apagado en desarrollo: el reenvío manual
# (POST /sagas/reenviar-notificaciones) funciona igual. Para probar el job, enciéndelo y baja los tiempos.
SAGA_REENVIO_NOTIFICACIONES_HABILITADO=false
SAGA_REENVIO_NOTIFICACIONES_INTERVALO=5m
SAGA_REENVIO_NOTIFICACIONES_LOTE=20
SAGA_REENVIO_NOTIFICACIONES_ESPERA_MINIMA=PT15M
SAGA_REENVIO_NOTIFICACIONES_PLAZO_RESPUESTA=PT10M
SAGA_REENVIO_NOTIFICACIONES_MAX_INTENTOS=3

# --- Kafka --------------------------------------------------------------------
# Un solo broker (desarrollo/pruebas): sin réplicas. Para probar con alta disponibilidad usa ../kafka/docker-compose.ha.yml
# con KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9092,broker-3:9092, KAFKA_REPLICATION_FACTOR=3 y KAFKA_MIN_ISR=2.
KAFKA_BOOTSTRAP_SERVERS=broker:9092
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_ISR=1
# Retención de las colas de mensajes fallidos (.dlq): 30 días. Los eventos usan la del broker (7 días).
KAFKA_DLQ_RETENCION_MS=2592000000

# --- Observabilidad (opcional) ------------------------------------------------
# OBSERVABILIDAD_HABILITADA=true levanta Prometheus, Alertmanager, Grafana, Loki, Alloy y los exportadores de Postgres y
# Kafka (los activa scripts/compose.sh). Apagada, los servicios funcionan igual. Guía: observabilidad/README.md.
OBSERVABILIDAD_HABILITADA=false
# Solo servidor Linux: CPU, memoria, disco y reloj del servidor (node-exporter y cAdvisor).
OBSERVABILIDAD_HOST_HABILITADA=false
# Logs en JSON (una línea por log) para Loki; apagado, texto legible.
LOG_FORMATO_JSON=false
# Un broker de Kafka al que se conecta el exportador (descubre los demás).
KAFKA_EXPORTER_BROKER=broker:9092

# --- Postgres: pooler, réplica y respaldo (opcionales; guía en ../../postgres/README.md) ----------------------------------
# Se aplican levantando el stack con ../postgres/compose.sh <ambiente> up -d (traduce estas banderas a perfiles de Compose).
# PgBouncer entre los servicios y Postgres: Postgres atiende pocas conexiones aunque los 7 servicios abran 140. Si es true,
# scripts/compose.sh apunta los servicios al pooler (DB_POOL_HOST/DB_POOL_PORT); las migraciones Flyway siguen directas.
PGBOUNCER_HABILITADO=false
PGBOUNCER_POOL_POR_ROL=10
PGBOUNCER_MAX_CONEXIONES_BD=100
# Réplica de solo lectura (streaming, sin conmutación automática). Necesita REPLICACION_DB_PASSWORD en el archivo de secretos.
REPLICACION_HABILITADA=false
# Respaldo continuo con pgBackRest: archiva el WAL y hace un respaldo completo semanal y uno diferencial diario; permite
# restaurar a un instante exacto. Necesita RESPALDO_CIFRADO_CLAVE en secretos. RESPALDO_REPO: posix (volumen aparte) o s3.
RESPALDO_HABILITADO=false
RESPALDO_REPO=s3
# Almacén S3 propio (SeaweedFS) solo para desarrollo/pruebas, con certificado autofirmado (por eso no se verifica el TLS).
# Necesita RESPALDO_S3_ACCESS_KEY y RESPALDO_S3_SECRET_KEY en secretos.
RESPALDO_ALMACEN_LOCAL_HABILITADO=true
RESPALDO_S3_VERIFICAR_TLS=n
RESPALDO_S3_BUCKET=respaldos-facturacion
RESPALDO_RETENCION_COMPLETOS=4
RESPALDO_RETENCION_DIFERENCIALES=7

# --- Alertas por correo (opcional; requiere OBSERVABILIDAD_HABILITADA=true) ---------------------------------------------
# Alertmanager envía cada alerta (críticas: cada hora hasta resolverse) a estos correos. La clave del SMTP va en el archivo de
# secretos (ALERTAS_SMTP_PASSWORD). Con Gmail: smtp.gmail.com:587 y una "contraseña de aplicación".
ALERTAS_CORREO_HABILITADO=false
ALERTAS_CORREO_DESTINATARIOS=
ALERTAS_CORREO_REMITENTE=
ALERTAS_SMTP_HOST=smtp.gmail.com:587
ALERTAS_SMTP_USUARIO=
ALERTAS_SMTP_REQUIERE_TLS=true
