<?xml version="1.0" encoding="UTF-8"?>
<!-- Agregador: solo sirve para construir todo con un comando (`mvn install` aquí). No es un pom padre: cada módulo
     conserva su propio pom y sigue siendo independiente. facturacion-commons va primero porque los 7 servicios
     lo declaran como dependencia. Sin esto, instálalo antes con `mvn -f facturacion-commons/pom.xml install`. -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.facturacion</groupId>
    <artifactId>facturacion-electronica-ec</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>facturacion-electronica-ec</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>facturacion-commons</module>
        <module>identidad-service</module>
        <module>firma-electronica-service</module>
        <module>inventario-service</module>
        <module>comprobantes-service</module>
        <module>sri-conector-service</module>
        <module>notificacion-service</module>
        <module>facturacion-orchestrator-service</module>
    </modules>
</project>
