# Copia esto a .env en esta misma carpeta antes de correr `docker compose up`.
# Nunca subas el .env real — contiene credenciales.
# El stack de kafka/ debe estar corriendo de antemano (su broker se
# reutiliza acá) — o lo levantas primero, o usas el docker-compose.yml de
# la raíz que levanta a ambos.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=ecommerce
POSTGRES_PORT=5433

# Una contraseña por cada rol de esquema. Generar con: openssl rand -base64 24
ORDER_DB_PASSWORD=change-me-order-service-secret
INVENTORY_DB_PASSWORD=change-me-inventory-service-secret
PAYMENT_DB_PASSWORD=change-me-payment-service-secret
SHIPPING_DB_PASSWORD=change-me-shipping-service-secret
NOTIFICATION_DB_PASSWORD=change-me-notification-service-secret
SAGA_DB_PASSWORD=change-me-saga-service-secret

# Puertos del host para la API REST de cada servicio.
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
SHIPPING_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
SAGA_ORCHESTRATOR_SERVICE_PORT=8086

# payment-service simula un rechazo cuando el total de la orden supera
# este monto — disparador determinista para poder ejercitar el camino de compensación.
PAYMENT_DECLINE_THRESHOLD=5000
